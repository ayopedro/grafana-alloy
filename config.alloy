logging {
  level  = "info"
  format = "logfmt"
}

// Legacy StatsD ingestion is private-only. Do not expose these ports publicly.
prometheus.exporter.statsd "statsd" {
  listen_tcp          = ":9125"
  listen_udp          = ":9126"
  mapping_config_path = "/etc/alloy/mapping-statsd.yaml"
}

prometheus.scrape "statsd" {
  targets         = prometheus.exporter.statsd.statsd.targets
  forward_to      = [prometheus.remote_write.grafana_cloud_metrics.receiver]
  scrape_interval = "10s"
}

prometheus.remote_write "grafana_cloud_metrics" {
  endpoint {
    url = sys.env("OTLP_METRICS_URL")
    basic_auth {
      username = sys.env("GRAFANA_METRICS_USERNAME")
      password = sys.env("GRAFANA_PASSWORD")
    }
  }
}

// One htpasswd entry per app; ingestion passwords are separate from Cloud tokens.
otelcol.auth.basic "ingestion" {
  htpasswd {
    inline = sys.env("ALLOY_INGESTION_HTPASSWD")
  }
}

otelcol.receiver.otlp "gateway" {
  grpc {
    endpoint = "[::]:4317"
    auth     = otelcol.auth.basic.ingestion.handler
  }
  http {
    endpoint = "[::]:4318"
    auth     = otelcol.auth.basic.ingestion.handler
  }
  output {
    metrics = [otelcol.processor.memory_limiter.gateway.input]
    logs    = [otelcol.processor.memory_limiter.gateway.input]
    traces  = [otelcol.processor.memory_limiter.gateway.input]
  }
}

otelcol.processor.memory_limiter "gateway" {
  check_interval = "1s"
  limit          = "256MiB"
  spike_limit    = "64MiB"
  output {
    metrics = [otelcol.exporter.otlphttp.grafana_cloud.input]
    logs    = [otelcol.exporter.otlphttp.grafana_cloud.input]
    traces  = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

// Mount persistent storage at /var/lib/alloy/data.
otelcol.storage.file "queue" {
  directory = "/var/lib/alloy/data/otlp-queue"
  fsync     = true
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_OTLP_ENDPOINT")
    // Explicit header avoids the v1.20.0 client_auth-only startup failure.
    headers = {
      "Authorization" = "Basic " + encoding.to_base64(sys.env("GRAFANA_OTLP_USERNAME") + ":" + sys.env("GRAFANA_PASSWORD")),
    }
  }
  retry_on_failure {
    enabled          = true
    initial_interval = "5s"
    max_interval     = "30s"
    max_elapsed_time = "0s"
  }
  sending_queue {
    enabled       = true
    num_consumers = 4
    queue_size    = 1000
    storage       = otelcol.storage.file.queue.handler
    // Persist before batching, rather than retaining batches in a processor.
    batch {
      flush_timeout = "1s"
      min_size      = 512
      max_size      = 1024
    }
  }
}
