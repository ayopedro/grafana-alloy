GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-<your-region>.grafana.net/otlp
GRAFANA_OTLP_USERNAME=<your-otlp-instance-id>
GRAFANA_PASSWORD=<grafana-cloud-token-with-metrics-logs-traces-write-scopes>

# App authentication: generate bcrypt entries with `htpasswd -nB my-app`.
ALLOY_INGESTION_HTPASSWD='my-app:<bcrypt-hash>'

# Existing StatsD pipeline uses the separate Prometheus remote-write connection.
OTLP_METRICS_URL=https://prometheus-prod-<your-region>.grafana.net/api/prom/push
GRAFANA_METRICS_USERNAME=<your-prometheus-instance-id>

# Optional platform ingress target port; Alloy itself listens on fixed port 4318.
PORT=4318
